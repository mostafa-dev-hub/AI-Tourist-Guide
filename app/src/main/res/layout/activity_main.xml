<?xml version="1.0" encoding="utf-8"?>
<LinearLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#E4E1DB"
    android:padding="20dp" android:layout_height="match_parent" android:layout_width="match_parent">

    <!-- Chatbot Image -->
    <ImageView
        android:id="@+id/chatbot_image"
        android:layout_width="500dp"
        android:layout_height="400dp"
        android:layout_marginBottom="40dp"
        android:contentDescription="Chatbot Image"
        android:src="@drawable/saud_robot" />

    <!-- Welcome Text -->
    <TextView
        android:id="@+id/welcome_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome To AI Tourist Guider!👋"
        android:textSize="30dp"
        android:textStyle="bold"
        android:textColor="#DE2D46"
        android:gravity="center"
        android:layout_marginBottom="30dp" />

    <!-- Chatbot Description -->
    <TextView
        android:id="@+id/chatbot_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Make your FIFA 2034 World-Cup Journey Smoother with Ai ! "
        android:textSize="20dp"
        android:textColor="#DE2D46"
        android:gravity="center"
        android:layout_marginBottom="30dp" />

    <!-- Start Chat Button -->
    <Button
        android:id="@+id/start_chat_button"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="#DE2D46"
        android:onClick="navigateToChatbotTextingActivity"
        android:padding="12dp"
        android:text="Get Started"
        android:textColor="@color/white"
        android:textSize="20dp" />
</LinearLayout>
