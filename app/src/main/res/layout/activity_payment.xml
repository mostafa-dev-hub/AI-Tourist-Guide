<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F3EB"
    tools:context=".PaymentActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Complete Your Payment"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:textColor="#DE2D46"
                android:textAlignment="center"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KSA World Cup 2034"
                android:textSize="16sp"
                android:fontFamily="sans-serif"
                android:textColor="#DE2D46"
                android:textAlignment="center"/>
        </LinearLayout>

        <!-- Ticket Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ticket Summary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#DE2D46"
                    android:layout_marginBottom="16dp"/>

                <!-- Ticket Details -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/matchNameText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Opening Match: KSA vs Brazil"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333"/>

                        <TextView
                            android:id="@+id/seatCategoryText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="VIP - Executive Box"
                            android:textColor="#555555"
                            android:layout_marginTop="4dp"/>

                        <TextView
                            android:id="@+id/matchDateText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="29/03/2025"
                            android:textColor="#555555"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ticketPriceText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$235.17"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="12dp"/>

                <!-- Service Fee -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Service Fee"
                        android:textColor="#555555"/>

                    <TextView
                        android:id="@+id/serviceFeeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$15.00"
                        android:textColor="#333333"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="12dp"/>

                <!-- Total Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>

                    <TextView
                        android:id="@+id/totalPriceText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$250.17"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#DE2D46"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Payment Methods Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Payment Method"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#DE2D46"
                    android:layout_marginBottom="16dp"/>

                <!-- Apple Pay Option -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/applePayCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0"
                    android:clickable="true"
                    android:focusable="true"
                    app:rippleColor="#DDDDDD">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/apple_pay_icon"
                            android:contentDescription="Apple Pay"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Apple Pay"
                            android:textSize="16sp"
                            android:textColor="#333333"
                            android:layout_marginStart="16dp"/>

                        <RadioButton
                            android:id="@+id/applePayRadio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#9D2235"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Google Pay Option -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/googlePayCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0"
                    android:clickable="true"
                    android:focusable="true"
                    app:rippleColor="#DDDDDD">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/google_pay_icon"
                            android:contentDescription="Google Pay"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Google Pay"
                            android:textSize="16sp"
                            android:textColor="#333333"
                            android:layout_marginStart="16dp"/>

                        <RadioButton
                            android:id="@+id/googlePayRadio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#9D2235"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- PayPal Option -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/paypalCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0"
                    android:clickable="true"
                    android:focusable="true"
                    app:rippleColor="#DDDDDD">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/paypal_icon"
                            android:contentDescription="PayPal"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PayPal"
                            android:textSize="16sp"
                            android:textColor="#333333"
                            android:layout_marginStart="16dp"/>

                        <RadioButton
                            android:id="@+id/paypalRadio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#9D2235"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Confirm Payment Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmPaymentButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Confirm Payment"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:backgroundTint="#009C3F"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"
            app:rippleColor="#FFFFFF"
            app:icon="@android:drawable/ic_menu_send"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF"
            android:elevation="4dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>